{
  "name": "tracelogdock",
  "version": "0.2.0",
  "private": true,
  "description": "Private desktop workbench for multi-project Docker logs and Arthas diagnostics.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:docs": "markdownlint-cli2",
    "check:links": "node scripts/check-doc-links.mjs",
    "check": "pnpm format:check && pnpm lint:docs && pnpm check:links && pnpm typecheck && pnpm test && pnpm build",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:desktop": "pnpm build && node scripts/smoke-desktop.mjs",
    "package:mac": "pnpm build && electron-builder --mac --dir",
    "test:remote": "pnpm build && node scripts/smoke-remote.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ssh2": "1.15.6",
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "markdownlint-cli2": "0.24.0",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.13"
  },
  "main": "out/main/index.js",
  "author": "526008793",
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ssh2": "1.17.0",
    "vue": "3.5.44",
    "zod": "4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "ignoredOptionalDependencies": [
      "cpu-features"
    ]
  },
  "build": {
    "appId": "app.tracelogdock.desktop",
    "productName": "TraceLogDock",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dir"
      ],
      "identity": null
    }
  }
}
